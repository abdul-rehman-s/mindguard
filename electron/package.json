{
  "name": "mindguard-desktop",
  "version": "5.0.0",
  "description": "MindGuard AI Desktop Companion — Production-grade activity tracking, focus detection, and productivity analytics",
  "main": "dist/main.js",
  "author": "Abdul Rehman <abdulrehmansudais824@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "better-sqlite3": "^11.7.0",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.12",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.mindguard.desktop",
    "productName": "MindGuard Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/abdul-rehman-s/mindguard/releases"
    }
  }
}
