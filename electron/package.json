{
  "name": "mindguard-desktop",
  "version": "1.0.0",
  "description": "MindGuard AI Desktop Companion — Production-grade activity tracking, focus detection, and productivity analytics",
  "main": "dist/main.js",
  "author": "Abdul Rehman <abdulrehmansudais824@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "better-sqlite3": "^11.7.0",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.12",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.abdulrehman.mindguard",
    "productName": "MindGuard",
    "copyright": "Copyright © 2024 Abdul Rehman",
    "compression": "maximum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Abdul Rehman"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerHeader": "assets/installer-banner.bmp",
      "allowElevation": true,
      "artifactName": "MindGuard-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MindGuard-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "abdul-rehman-s",
      "repo": "mindguard"
    }
  }
}
