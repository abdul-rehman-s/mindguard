generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  password      String
  displayName   String?
  onboarded     Boolean           @default(false)
  primaryUse    String?
  xp            Int               @default(0)
  level         Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  missions         Mission[]
  focusSessions    FocusSession[]
  reflections      DailyReflection[]
  achievements     Achievement[]
  desktopActivities DesktopActivity[]
  notifications    Notification[]
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active")
  priority    String   @default("medium")
  userId      String
  createdAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]
}

model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  missionId String?
  duration  Int
  startedAt DateTime
  endedAt   DateTime
  quality   Int?
  type      String?   @default("focus")
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
}

model DailyReflection {
  id             String   @id @default(cuid())
  userId         String
  date           String
  distraction    String
  wentWell       String
  tomorrowMission String
  mood           Int?
  energy         Int?
  sleepHours     Float?
  tags           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  type      String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model DesktopActivity {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "focus" | "idle" | "distracted" | "break" | "deep_work" | "app_usage" | "website_usage"
  title         String?
  category      String?  // "coding" | "design" | "communication" | "entertainment" | "research" | "other"
  duration      Int      // seconds
  startedAt     DateTime
  endedAt       DateTime?
  application   String?  // placeholder: app name from Electron/Tauri
  website       String?  // placeholder: domain from Electron/Tauri
  metadata      String?  // JSON string for extensible data
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "idle_alert" | "break_reminder" | "mission_reminder" | "reflection_reminder" | "focus_celebration" | "streak_milestone" | "achievement_unlocked"
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?  // optional deep link
  metadata  String?  // JSON for extensible data
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
