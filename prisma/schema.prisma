generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  password      String
  displayName   String?
  onboarded     Boolean           @default(false)
  primaryUse    String?
  xp            Int               @default(0)
  level         Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  missions         Mission[]
  focusSessions    FocusSession[]
  reflections      DailyReflection[]
  achievements     Achievement[]
  desktopActivities DesktopActivity[]
  desktopSettings   DesktopSettings?
  notifications    Notification[]
  memories          Memory[]
  conversations     Conversation[]
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active")
  priority    String   @default("medium")
  userId      String
  createdAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]
}

model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  missionId String?
  duration  Int
  startedAt DateTime
  endedAt   DateTime
  quality   Int?
  type      String?   @default("focus")
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
}

model DailyReflection {
  id             String   @id @default(cuid())
  userId         String
  date           String
  distraction    String
  wentWell       String
  tomorrowMission String
  mood           Int?
  energy         Int?
  sleepHours     Float?
  tags           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  type      String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model DesktopActivity {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "focus" | "idle" | "distracted" | "break" | "deep_work" | "learning" | "coding" | "writing" | "meetings" | "browsing" | "entertainment" | "gaming" | "app_usage" | "website_usage"
  title         String?  // window title or activity description
  category      String?  // "coding" | "design" | "communication" | "entertainment" | "research" | "writing" | "meetings" | "learning" | "other"
  duration      Int      // seconds
  startedAt     DateTime
  endedAt       DateTime?
  application   String?  // app name from desktop tracker (e.g. "VS Code", "Chrome")
  website       String?  // domain from desktop tracker (e.g. "github.com")
  metadata      String?  // JSON string for extensible data (keyboard/mouse activity, etc.)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, type])
  @@index([userId, category])
}

model DesktopSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  autoStart         Boolean  @default(false)
  runInBackground   Boolean  @default(true)
  privacyMode       Boolean  @default(false)
  trackingEnabled   Boolean  @default(true)
  trackingExclusions String?  // JSON array of excluded apps/websites
  blockedApps       String?  // JSON array of blocked app names
  blockedWebsites   String?  // JSON array of blocked website domains
  notificationPrefs String?  // JSON object: { idleAlert, breakReminder, focusCelebration, missionReminder }
  focusProtection   Boolean  @default(false)
  muteNotifications Boolean  @default(false)
  trackerInterval   Int      @default(30)  // tracking poll interval in seconds
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "idle_alert" | "break_reminder" | "mission_reminder" | "reflection_reminder" | "focus_celebration" | "streak_milestone" | "achievement_unlocked"
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?  // optional deep link
  metadata  String?  // JSON for extensible data
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Memory {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "habit" | "pattern" | "preference" | "insight" | "summary" | "conversation" | "weekly_report" | "streak" | "distraction_pattern" | "best_hours" | "work_preference"
  content     String   // the actual memory text
  importance  Int      @default(5)  // 1-10 scale
  score       Float    @default(0)  // relevance/decay score
  context     String?  // JSON: additional metadata about this memory
  source      String?  // "reflection" | "session" | "activity" | "achievement" | "ai_generated" | "manual"
  sourceId    String?  // ID of the source entity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, importance])
  @@index([userId, createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  role        String   // "user" | "assistant" | "system"
  content     String
  timestamp   DateTime @default(now())
  sessionId   String?  // groups messages in same conversation session

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId])
  @@index([userId, timestamp])
}
