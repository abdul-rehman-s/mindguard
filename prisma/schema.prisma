generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  password      String
  displayName   String?
  onboarded     Boolean           @default(false)
  primaryUse    String?
  xp            Int               @default(0)
  level         Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Onboarding personalization fields
  workSchedule      String?    // "morning" | "evening" | "night" | "flexible"
  preferredFocusDuration Int?  // minutes: 25 | 45 | 60 | 90 | 120
  biggestDistraction String?    // "tiktok" | "youtube" | "facebook" | "instagram" | "discord" | "gaming" | "netflix" | "phone" | "other"
  goals             String?    // JSON array: ["deep_work", "screen_time", "habits", ...]
  distractionsList  String?    // JSON array of specific distraction names
  focusGoalMinutes  Int?       // daily focus goal in minutes
  dailyCoachEnabled Boolean @default(true)
  sidebarCollapsed  Boolean @default(false)
  commandPaletteUsed Boolean @default(false)
  lastActiveAt      DateTime?

  // Psychological profiling fields (Task 2-c)
  chronotype        String?    // "early_bird" | "night_owl" | "flexible" — derived from scheduleType
  coachPersonality  String?    // "strict" | "friendly" | "data_nerd"
  motivationStyle   String?    // "gamification" | "minimalist" | "balanced"
  focusStyle        String?    // "pomodoro" | "deep_work" | "flexible" — derived from workStylePreference
  hasAdhd           Boolean?   @default(false)
  role              String?    // "student" | "developer" | "designer" | "freelancer" | etc.
  wakeTime          String?    // legacy — no longer required in onboarding
  sleepTime         String?    // now stores sleep range: "before_midnight" | "12_2am" | "2_4am" | "after_4am" | "varies"
  workHours         Int?       // legacy — no longer required in onboarding
  pomodoroPreference String?   // derived from focusDurationComfort
  deepWorkDuration  Int?       // derived from focusDurationComfort
  preferredSchedule String?    // "structured" | "flexible" — derived from workStylePreference
  distractionRanking String?   // JSON array of ranked top 3 distractions

  // UX Rebirth raw answer fields — store user's natural answers for AI personalization
  scheduleType      String?    // "morning_person" | "night_owl" | "flexible_schedule" | "changes_frequently"
  sleepRange        String?    // "before_midnight" | "12_2am" | "2_4am" | "after_4am" | "varies"
  focusDurationComfort String? // "15min" | "30min" | "45min" | "about_an_hour" | "90_plus" | "it_depends"
  workStylePreference String?  // "short_sprints" | "deep_uninterrupted" | "mix_both"
  otherImproveText  String?    // free-text answer when user selects "Other" in improve step

  missions         Mission[]
  focusSessions    FocusSession[]
  reflections      DailyReflection[]
  achievements     Achievement[]
  desktopActivities DesktopActivity[]
  desktopSettings   DesktopSettings?
  notifications    Notification[]
  userSettings      UserSettings?
  devices          Device[]
  habits           Habit[]
  habitEntries     HabitEntry[]
  memories         Memory[]
  pendingPairing   Boolean  @default(false)
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("active")
  priority    String   @default("medium")
  userId      String
  createdAt   DateTime @default(now())
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]
}

model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  missionId String?
  duration  Int
  startedAt DateTime
  endedAt   DateTime
  quality   Int?
  type      String?   @default("focus")
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
}

model DailyReflection {
  id             String   @id @default(cuid())
  userId         String
  date           String
  distraction    String
  wentWell       String
  tomorrowMission String
  mood           Int?
  energy         Int?
  sleepHours     Float?
  tags           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  type      String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model DesktopActivity {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "focus" | "idle" | "distracted" | "break" | "deep_work" | "learning" | "coding" | "writing" | "meetings" | "browsing" | "entertainment" | "gaming" | "app_usage" | "website_usage"
  title         String?  // window title or activity description
  category      String?  // "coding" | "design" | "communication" | "entertainment" | "research" | "writing" | "meetings" | "learning" | "other"
  duration      Int      // seconds
  startedAt     DateTime
  endedAt       DateTime?
  application   String?  // app name from desktop tracker (e.g. "VS Code", "Chrome")
  website       String?  // domain from desktop tracker (e.g. "github.com")
  metadata      String?  // JSON string for extensible data (keyboard/mouse activity, etc.)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, type])
  @@index([userId, category])
}

model DesktopSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  autoStart         Boolean  @default(false)
  runInBackground   Boolean  @default(true)
  privacyMode       Boolean  @default(false)
  trackingEnabled   Boolean  @default(true)
  trackingExclusions String?  // JSON array of excluded apps/websites
  blockedApps       String?  // JSON array of blocked app names
  blockedWebsites   String?  // JSON array of blocked website domains
  notificationPrefs String?  // JSON object: { idleAlert, breakReminder, focusCelebration, missionReminder }
  focusProtection   Boolean  @default(false)
  muteNotifications Boolean  @default(false)
  trackerInterval   Int      @default(30)  // tracking poll interval in seconds
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "idle_alert" | "break_reminder" | "mission_reminder" | "reflection_reminder" | "focus_celebration" | "streak_milestone" | "achievement_unlocked"
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?  // optional deep link
  metadata  String?  // JSON for extensible data
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  // General
  language          String   @default("en")
  timezone          String?
  // Appearance
  theme             String   @default("dark")  // "light" | "dark" | "system"
  sidebarCollapsed  Boolean  @default(false)
  compactMode       Boolean  @default(false)
  // Focus
  defaultFocusDuration Int   @default(25)
  focusGoalMinutes  Int      @default(120) // daily goal
  autoStartTimer    Boolean  @default(false)
  showCelebration   Boolean  @default(true)
  ambientSound      String?  // "rain" | "classical" | "deep_focus" | null
  // Notifications
  desktopNotifications Boolean @default(true)
  breakReminders    Boolean  @default(true)
  missionReminders  Boolean @default(true)
  streakReminders   Boolean @default(true)
  achievementAlerts Boolean @default(true)
  idleAlerts        Boolean  @default(true)
  // Privacy
  shareStats        Boolean  @default(false)
  publicProfile     Boolean  @default(false)
  // Keyboard
  customShortcuts   String?  // JSON object for custom shortcuts
  // Advanced
  debugMode         Boolean  @default(false)
  dataExportEnabled Boolean  @default(true)
  // AI Coach
  aiProvider        String   @default("z-ai")  // "z-ai" | "openai" | "deepseek" | "openrouter" | "gemini" | "anthropic" | "ollama"
  aiApiKey          String?   // encrypted API key for external providers
  aiModel           String?   // specific model name (e.g., "gpt-4", "claude-3-opus")
  aiOllamaUrl       String?   // local Ollama server URL
  coachPersonality  String   @default("friendly")  // "strict" | "friendly" | "data_nerd"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  deviceName      String?   // "MacBook Pro" etc
  deviceType      String    @default("desktop")  // "desktop" | "mobile" | "web"
  platform        String?   // "mac" | "win" | "linux"
  pairingToken    String?   @unique  // short-lived JWT for initial pairing
  pairingExpiry   DateTime? // when pairing token expires
  refreshToken    String?   // encrypted refresh token
  lastSyncAt      DateTime? @default(now())
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pairingToken])
  @@index([userId, isActive])
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String?    // emoji or icon name
  frequency   String     @default("daily")  // "daily" | "weekly" | "custom"
  targetCount Int        @default(1)          // how many times per frequency period
  color       String?    // hex color for visualization
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId, isActive])
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String    // "YYYY-MM-DD"
  count     Int       @default(1)
  note      String?
  createdAt DateTime  @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "best_hours" | "distraction_pattern" | "work_preference" | "streak" | "habit" | "pattern" | "insight" | "weekly_report" | "preference" | "summary" | "conversation"
  content    String
  importance Int      @default(5)
  score      Float    @default(0)
  source     String?  // "session" | "activity" | "reflection" | "achievement" | "ai_generated"
  sourceId   String?
  context    String?  // JSON string for extensible data
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([userId, importance])
}
